    function startPomodoroSession() {
      clearInterval(pomoInterval);
      document.getElementById('parentSessionStatus').innerText = `LIVE (${TRACK_CONFIG[appState.track].badge})`;
      document.getElementById('parentSessionStatus').className = "px-3.5 py-1.5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold";
      addParentFeed(`🟢 Started focused Pomodoro session (${Math.ceil(pomoSeconds / 60)} min) on ${TRACK_CONFIG[appState.track].badge}.`);
      showToast("Focus session started! Guardian notified.", "emerald");

      pomoInterval = setInterval(() => {
        if (pomoSeconds > 0) {
          pomoSeconds--;
          const m = String(Math.floor(pomoSeconds / 60)).padStart(2, '0');
          const s = String(pomoSeconds % 60).padStart(2, '0');
          document.getElementById('pomodoroClockDisplay').innerText = `${m}:${s}`;
          if (pomoSeconds === 0) {
            clearInterval(pomoInterval);
            appState.xp += 100;
            appState.depositUnlocked = Math.min(700, appState.depositUnlocked + 70);
            saveState();
            updateDepositUI();
            addParentFeed(`✅ Completed full focus session! +₹70 Refundable Escrow unlocked.`);
            showToast("🎉 Session Complete! +100 XP & +₹70 Escrow Unlocked!", "emerald");
          }
        }
      }, 1000);
    }

    function endPomodoroEarly() {
      clearInterval(pomoInterval);
      appState.earlyExits++;
      saveState();
      document.getElementById('parentEarlyExitsText').innerText = `${appState.earlyExits} Early Exit${appState.earlyExits > 1 ? 's' : ''}`;
      document.getElementById('parentSessionStatus').innerText = "Ended Early";
      addParentFeed(`⚠️ Voluntary early exit logged during focus block.`);
      showToast("Session ended early. Parent log updated.", "rose");
    }

    function addParentFeed(msg) {
      const feed = document.getElementById('parentActivityFeed');
      const div = document.createElement('div');
      div.className = "p-3 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-borderdark flex justify-between";
      div.innerHTML = `<span>${msg}</span><span class="font-mono text-slate-500">Just now</span>`;
      feed.prepend(div);
    }

    // 13. SYLLABUS TRACKER & 70% REFUNDABLE DEPOSIT UI
    function renderSyllabusChecklist() {
      const list = TRACK_CONFIG[appState.track].syllabus;
      const doneCount = list.filter(item => appState.completedSyllabus[item.id]).length;
      document.getElementById('syllabusCountBadge').innerText = `${doneCount} / ${list.length} Completed`;

      document.getElementById('syllabusChecklistGrid').innerHTML = list.map(item => {
        const checked = !!appState.completedSyllabus[item.id];
        return `
          <label class="p-3.5 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-borderdark flex items-center gap-3 cursor-pointer hover:border-neoncyan transition">
            <input type="checkbox" ${checked ? 'checked' : ''} onchange="toggleSyllabusItem('${item.id}')" class="w-4 h-4 accent-neoncyan rounded" />
            <span class="text-xs font-semibold ${checked ? 'line-through text-slate-500' : ''}">${item.title}</span>
          </label>
        `;
      }).join('');
    }

    function toggleSyllabusItem(id) {
      const next = !appState.completedSyllabus[id];
      appState.completedSyllabus[id] = next;
      if (next) {
        appState.xp += 50;
        appState.depositUnlocked = Math.min(700, appState.depositUnlocked + 35);
        showToast("Chapter Mastered! +50 XP & +₹35 Escrow Unlocked!", "emerald");
      }
      saveState();
      renderSyllabusChecklist();
      updateDepositUI();
    }

    function updateDepositUI() {
      const amt = appState.depositUnlocked;
      const pct = Math.round((amt / 700) * 100);
      document.getElementById('depositUnlockedAmount').innerText = `₹${amt}`;
      document.getElementById('depositPercentLabel').innerText = `${pct}%`;
      document.getElementById('depositProgressBar').style.width = `${pct}%`;
      document.getElementById('parentEscrowText').innerText = `₹${amt} / ₹700 Unlocked`;
    }

    function claimRefundPayout() {
      const upi = document.getElementById('guardianUpiInput').value.trim();
      if (!upi) return showToast("Please enter a valid Guardian UPI ID.", "rose");
      const txnId = "EIC_UPI_" + Math.floor(10000000 + Math.random() * 90000000);
      const banner = document.getElementById('refundReceiptBanner');
      banner.classList.remove('hidden');
      banner.innerHTML = `<strong>✅ ₹${appState.depositUnlocked}.00 Disbursed via RBI-Compliant Escrow!</strong><br>Beneficiary: <span class="font-mono">${upi}</span> • Reference: <span class="font-mono">${txnId}</span>`;
      showToast(`₹${appState.depositUnlocked} transferred to ${upi}!`, "emerald");
    }

    // 14. SOCRATIC AI MODAL & MENTOR EVALUATION
    function openAskAiModal() { document.getElementById('askAiModal').classList.remove('hidden'); }
    function closeAskAiModal() { document.getElementById('askAiModal').classList.add('hidden'); }

    function sendAiModalMessage() {
      const inp = document.getElementById('aiModalInput');
      const q = inp.value.trim();
      if (!q) return;
      const box = document.getElementById('aiModalMessages');
      box.innerHTML += `<div class="p-2.5 rounded-xl bg-sky-500/15 border border-sky-500/30 text-right"><strong>You:</strong> ${q}</div>`;
      inp.value = '';
      setTimeout(() => {
        const v = TRACK_CONFIG[appState.track].videos[currentVideoIdx];
        box.innerHTML += `<div class="p-2.5 rounded-xl bg-violet-500/15 border border-violet-500/30"><strong>Socratic AI (${v.teacher}):</strong> Great question! First, recall the core boundary condition from <em>${v.title}</em>: how does the system respond when we test its limiting case? Try checking that step on the Study Whiteboard!</div>`;
        box.scrollTop = box.scrollHeight;
      }, 350);
    }

    function publishMentorReview() {
      const score = document.getElementById('mentorScoreInput').value;
      const remark = document.getElementById('mentorFeedbackInput').value;
      appState.xp += 50;
      saveState();
      showToast(`Mentor grade (${score}/10) published! Student awarded +50 XP.`, "emerald");
      addParentFeed(`🧑‍🏫 Mentor graded recall sheet (${score}/10): "${remark}"`);
    }

    // 15. INITIALIZATION
    window.addEventListener('resize', () => {
      resizeAndRedrawWhiteboard();
      renderInteractiveSimulator();
    });

    window.addEventListener('DOMContentLoaded', () => {
      updateHeaderTelemetry();
      switchExamTrack(appState.track);
      renderStudentNotes();
      renderPlatformsDirectory('all');
      updateDepositUI();
      initStudyWhiteboard();
    });
  </script>
</body>
</html>
