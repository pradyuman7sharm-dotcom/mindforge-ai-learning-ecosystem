    async function fetchUniversalKnowledge(query) {
      const statusTag = document.getElementById('wikiStatusTag');
      statusTag.innerText = "Fetching Live APIs...";
      statusTag.className = "text-[11px] text-amber-400 font-mono";

      // A) Fetch Wikipedia Summary + OpenSearch
      try {
        const searchRes = await fetch(`https://en.wikipedia.org/w/api.php?action=opensearch&search=${encodeURIComponent(query)}&limit=6&format=json&origin=*`);
        const searchData = await searchRes.json();
        const bestTitle = (searchData[1] && searchData[1][0]) ? searchData[1][0] : query;

        // Render related topic pills
        const relatedTitles = searchData[1] || [];
        document.getElementById('wikiRelatedBar').innerHTML = relatedTitles.length
          ? `<span class="text-slate-400 font-bold">Related Concepts:</span>` + relatedTitles.map(rt => `
              <button onclick="document.getElementById('vaultQueryInput').value='${rt.replace(/'/g, "\\'")}'; fetchUniversalKnowledge('${rt.replace(/'/g, "\\'")}')" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 border border-slate-700 hover:border-neoncyan text-[11px]">
                ${rt}
              </button>
            `).join('')
          : '';

        const sumRes = await fetch(`https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(bestTitle)}`);
        if (!sumRes.ok) throw new Error("Summary not found");
        const sumData = await sumRes.json();

        lastFetchedWiki = {
          title: sumData.title || bestTitle,
          description: sumData.description || "Encyclopedic Concept Entry",
          extract: sumData.extract || "Summary retrieved from Wikipedia.",
          url: sumData.content_urls?.desktop?.page || `https://en.wikipedia.org/wiki/${encodeURIComponent(bestTitle)}`
        };

        document.getElementById('wikiTitle').innerText = lastFetchedWiki.title;
        document.getElementById('wikiDescription').innerText = lastFetchedWiki.description;
        document.getElementById('wikiExtract').innerText = lastFetchedWiki.extract;
        document.getElementById('wikiFullUrl').href = lastFetchedWiki.url;

        const thumbEl = document.getElementById('wikiThumbnail');
        if (sumData.thumbnail?.source) {
          thumbEl.src = sumData.thumbnail.source;
          thumbEl.classList.remove('hidden');
        } else {
          thumbEl.classList.add('hidden');
        }

        statusTag.innerText = "Live Synced ✓";
        statusTag.className = "text-[11px] text-emerald-400 font-mono";
      } catch (err) {
        const fb = OFFLINE_WIKI_FALLBACK[query] || {
          title: query,
          description: "Verified Conceptual Reference",
          extract: `Comprehensive study synthesis for ${query}. Connect this topic with NCERT fundamentals, past-year examination questions, and first-principles derivations.`,
          url: `https://en.wikipedia.org/wiki/${encodeURIComponent(query)}`
        };
        lastFetchedWiki = fb;
        document.getElementById('wikiTitle').innerText = fb.title;
        document.getElementById('wikiDescription').innerText = fb.description;
        document.getElementById('wikiExtract').innerText = fb.extract;
        document.getElementById('wikiFullUrl').href = fb.url;
        document.getElementById('wikiThumbnail').classList.add('hidden');
        statusTag.innerText = "Cached Reference";
        statusTag.className = "text-[11px] text-sky-400 font-mono";
      }

      // B) Fetch Peer-Reviewed Research Papers from OpenAlex API
      const papersBox = document.getElementById('openAlexPapersList');
      papersBox.innerHTML = `<p class="text-xs text-slate-400 font-mono">Querying OpenAlex scholarly repository...</p>`;
      try {
        const oaRes = await fetch(`https://api.openalex.org/works?search=${encodeURIComponent(query)}&per-page=4`);
        const oaData = await oaRes.json();
        const works = oaData.results || [];
        if (works.length > 0) {
          papersBox.innerHTML = works.map(w => {
            const authors = (w.authorships || []).slice(0, 2).map(a => a.author?.display_name).filter(Boolean).join(', ') || 'Academic Consortium';
            const link = w.doi || w.id || '#';
            return `
              <div class="p-3 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-borderdark space-y-1">
                <div class="flex justify-between text-[10px] font-mono text-amber-400">
                  <span>Year: ${w.publication_year || 'N/A'}</span>
                  <span>Citations: ${w.cited_by_count ?? 0}</span>
                </div>
                <a href="${link}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold hover:text-neoncyan block leading-snug">
                  ↗ ${w.title || 'Scholarly Work'}
                </a>
                <p class="text-[11px] text-slate-500 truncate">${authors}</p>
              </div>
            `;
          }).join('');
        } else {
          papersBox.innerHTML = `<p class="text-xs text-slate-400">No direct OpenAlex works matched. Try a broader scientific or policy keyword.</p>`;
        }
      } catch (e) {
        papersBox.innerHTML = `<p class="text-xs text-slate-400">OpenAlex scholarly index temporarily unreachable. Wikipedia synthesis remains active.</p>`;
      }
    }

