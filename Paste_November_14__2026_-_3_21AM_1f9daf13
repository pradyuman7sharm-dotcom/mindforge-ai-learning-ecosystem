    // 12. WEB AUDIO API FOCUS SYNTHESIZER (BROWN NOISE + 40HZ ALPHA) & POMODORO
    let audioCtx = null;
    let activeAudioNode = null;
    let masterGainNode = null;
    let pomoSeconds = 25 * 60;
    let pomoInterval = null;

    function ensureAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();
        masterGainNode = audioCtx.createGain();
        masterGainNode.gain.value = parseFloat(document.getElementById('synthVolumeSlider')?.value || 0.35);
        masterGainNode.connect(audioCtx.destination);
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
    }

    function toggleFocusAudio(type) {
      stopFocusAudio(true);
      ensureAudioContext();

      if (type === 'brown') {
        const bufferSize = 2 * audioCtx.sampleRate;
        const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        let lastOut = 0.0;
        for (let i = 0; i < bufferSize; i++) {
          const white = Math.random() * 2 - 1;
          output[i] = (lastOut + 0.02 * white) / 1.02;
          lastOut = output[i];
          output[i] *= 3.5;
        }
        const whiteNoise = audioCtx.createBufferSource();
        whiteNoise.buffer = noiseBuffer;
        whiteNoise.loop = true;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 380;

        whiteNoise.connect(filter);
        filter.connect(masterGainNode);
        whiteNoise.start(0);
        activeAudioNode = whiteNoise;

        document.getElementById('audioSynthBadge').innerText = "Brown Noise Active";
        document.getElementById('audioSynthBadge').className = "px-2.5 py-0.5 rounded-full bg-sky-500/20 text-neoncyan text-[10px] font-mono";
        showToast("🌊 Brown Noise focus masking enabled (Web Audio DSP).");
      } else {
        const osc1 = audioCtx.createOscillator();
        const osc2 = audioCtx.createOscillator();
        osc1.type = 'sine';
        osc2.type = 'sine';
        osc1.frequency.value = 200;
        osc2.frequency.value = 240; // 40Hz Gamma/Alpha focus beat
        osc1.connect(masterGainNode);
        osc2.connect(masterGainNode);
        osc1.start();
        osc2.start();
        activeAudioNode = { stop: () => { osc1.stop(); osc2.stop(); } };

        document.getElementById('audioSynthBadge').innerText = "40Hz Focus Hum";
        document.getElementById('audioSynthBadge').className = "px-2.5 py-0.5 rounded-full bg-violet-500/20 text-neonviolet text-[10px] font-mono";
        showToast("🧠 40Hz Binaural Focus Hum active.");
      }
    }

    function stopFocusAudio(silent = false) {
      if (activeAudioNode) {
        try { activeAudioNode.stop(); } catch (e) {}
        activeAudioNode = null;
      }
      document.getElementById('audioSynthBadge').innerText = "Audio Off";
      document.getElementById('audioSynthBadge').className = "px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 text-[10px] font-mono";
      if (!silent) showToast("Focus audio muted.");
    }

    function updateSynthVolume(val) {
      if (masterGainNode) masterGainNode.gain.value = parseFloat(val);
    }

    function setPomodoroDuration(mins) {
      clearInterval(pomoInterval);
      pomoSeconds = mins * 60;
      document.getElementById('pomodoroClockDisplay').innerText = `${String(mins).padStart(2, '0')}:00`;
