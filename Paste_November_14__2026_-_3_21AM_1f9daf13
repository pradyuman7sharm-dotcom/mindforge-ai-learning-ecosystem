            <button onclick="switchTab('platforms')" class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs border border-white/15 transition">
              🚀 25+ Learning Portals
            </button>
          </div>
        </div>

        <!-- Lecture Selector Pills -->
