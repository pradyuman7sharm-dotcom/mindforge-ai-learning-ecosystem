      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            obsidian: '#070b14',
            carddark: '#0f172a',
            borderdark: '#1e293b',
            neoncyan: '#38bdf8',
            neongreen: '#10b981',
            neonviolet: '#8b5cf6',
            neonamber: '#f59e0b'
