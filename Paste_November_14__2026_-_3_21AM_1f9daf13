    let simPhase = 0;
    function renderInteractiveSimulator() {
      const canvas = document.getElementById('interactiveSimCanvas');
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      if (rect.width > 0 && rect.height > 0) {
        canvas.width = Math.floor(rect.width);
        canvas.height = Math.floor(rect.height);
      }
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0, 0, w, h);

      const p1 = parseFloat(document.getElementById('simP1')?.value || 0.7);
      const p2 = parseFloat(document.getElementById('simP2')?.value || 300);
      const p3 = parseFloat(document.getElementById('simP3')?.value || 5.6);

      if (document.getElementById('simP1Val')) document.getElementById('simP1Val').innerText = p1;
      if (document.getElementById('simP2Val')) document.getElementById('simP2Val').innerText = p2;
      if (document.getElementById('simP3Val')) document.getElementById('simP3Val').innerText = p3;

      const readout = document.getElementById('simLiveReadout');
      const track = appState.track;

      if (track === 'jee' && jeeSimMode === 'diode') {
        const ox = w * 0.52, oy = h * 0.62;
        ctx.strokeStyle = '#334155'; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(20, oy); ctx.lineTo(w - 20, oy); ctx.moveTo(ox, 16); ctx.lineTo(ox, h - 16); ctx.stroke();

        // Forward Bias Exponential Curve
        ctx.strokeStyle = '#38bdf8'; ctx.lineWidth = 3; ctx.beginPath();
        const kneePx = ox + p1 * 95;
        ctx.moveTo(ox, oy);
        for (let x = ox; x < w - 25; x += 3) {
          const v = (x - ox) / 95;
          const tempFactor = 300 / p2;
          const curr = v < p1 ? (v / p1) * 4 : 4 + Math.pow((v - p1) * 6.5, 2.2) * tempFactor;
          const y = Math.max(20, oy - curr);
          ctx.lineTo(x, y);
        }
        ctx.stroke();

        // Reverse Bias & Zener Breakdown
        ctx.strokeStyle = '#f43f5e'; ctx.lineWidth = 3; ctx.beginPath();
        ctx.moveTo(ox, oy);
        const zenerPx = ox - p3 * 24;
        ctx.lineTo(Math.max(30, zenerPx), oy + 4);
        ctx.lineTo(Math.max(25, zenerPx - 6), h - 18);
        ctx.stroke();

        ctx.fillStyle = '#94a3b8'; ctx.font = '11px JetBrains Mono';
        ctx.fillText(`Knee V₀=${p1}V`, kneePx - 20, oy + 16);
        ctx.fillText(`-V_Z=-${p3}V`, Math.max(28, zenerPx - 22), oy - 8);

        const material = p1 <= 0.4 ? "Germanium (Ge)" : "Silicon (Si)";
        readout.innerHTML = `
          <div><span class="text-slate-500 block">Semiconductor</span><strong class="text-neoncyan">${material}</strong></div>
          <div><span class="text-slate-500 block">Thermal Voltage</span><strong class="text-neonviolet">${(p2 * 0.0862).toFixed(1)} mV</strong></div>
          <div><span class="text-slate-500 block">Breakdown Mode</span><strong class="text-rose-400">Zener (-${p3}V)</strong></div>
        `;
      } else if (track === 'jee' && jeeSimMode === 'projectile') {
        const baseY = h - 22;
        ctx.strokeStyle = '#334155'; ctx.beginPath(); ctx.moveTo(24, baseY); ctx.lineTo(w - 24, baseY); ctx.stroke();
        const rad = (p2 * Math.PI) / 180;
        const maxH = (p1 * p1 * Math.sin(rad) ** 2) / (2 * p3);
        const range = (p1 * p1 * Math.sin(2 * rad)) / p3;
        const tof = (2 * p1 * Math.sin(rad)) / p3;

        ctx.strokeStyle = '#38bdf8'; ctx.lineWidth = 3; ctx.beginPath();
        const scale = Math.min(0.75, (w - 60) / Math.max(260, range));
        for (let i = 0; i <= 50; i++) {
          const t = (tof * i) / 50;
          const x = 30 + p1 * Math.cos(rad) * t * scale;
          const y = baseY - (p1 * Math.sin(rad) * t - 0.5 * p3 * t * t) * scale;
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();
        readout.innerHTML = `
          <div><span class="text-slate-500 block">Max Height</span><strong class="text-neoncyan">${maxH.toFixed(1)} m</strong></div>
          <div><span class="text-slate-500 block">Horizontal Range</span><strong class="text-neonviolet">${range.toFixed(1)} m</strong></div>
          <div><span class="text-slate-500 block">Time of Flight</span><strong class="text-emerald-400">${tof.toFixed(2)} s</strong></div>
        `;
      } else if (track === 'neet') {
        const midY = h * 0.62;
        ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2.5; ctx.beginPath();
        const freqScale = p1 / 75;
        for (let x = 16; x < w - 16; x++) {
          const ph = (((x * freqScale) + simPhase) % 150) / 150;
          let y = midY;
          if (ph > 0.14 && ph < 0.24) y -= Math.sin((ph - 0.14) * 10 * Math.PI) * 18;
          else if (ph >= 0.34 && ph < 0.37) y += 14;
          else if (ph >= 0.37 && ph < 0.42) y -= h * 0.44;
          else if (ph >= 0.42 && ph < 0.46) y += 22;
          else if (ph > 0.60 && ph < 0.76) y -= Math.sin((ph - 0.60) * 6.25 * Math.PI) * 24;
          if (x === 16) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();

        const co = ((p1 * p2) / 1000).toFixed(2);
        const cycleSec = (60 / p1).toFixed(2);
        const bohr = p3 > 43 ? "Right Shift (O₂ Unload)" : p3 < 37 ? "Left Shift (Bind)" : "Normal P₅₀ 26.8";
        readout.innerHTML = `
          <div><span class="text-slate-500 block">Cardiac Output</span><strong class="text-emerald-400">${co} L/min</strong></div>
          <div><span class="text-slate-500 block">Cycle Duration</span><strong class="text-neoncyan">${cycleSec} sec</strong></div>
          <div><span class="text-slate-500 block">Hb-O₂ Curve</span><strong class="text-rose-400">${bohr}</strong></div>
        `;
      } else {
        const baseY = h - 25;
        ctx.strokeStyle = '#334155'; ctx.beginPath(); ctx.moveTo(24, baseY); ctx.lineTo(w - 24, baseY); ctx.stroke();
        const cpi = Math.max(2.1, 7.9 - (p1 - 5.0) * 0.65 - (p2 - 4.0) * 0.3 + (p3 - 4.5) * 0.55);
        const gdp = Math.max(4.5, 7.6 - (p1 - 6.0) * 0.35 + (p3 - 4.5) * 0.25);

        // RBI 4% Target Band
        ctx.fillStyle = 'rgba(16, 185, 129, 0.12)';
        ctx.fillRect(24, baseY - 6 * 18, w - 48, 4 * 18);

        ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 3; ctx.beginPath();
        for (let i = 0; i <= 10; i++) {
          const x = 30 + (i / 10) * (w - 60);
          const proj = 6.2 + ((cpi - 6.2) * (i / 10));
          const y = baseY - proj * 18;
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();

        const bandStatus = cpi <= 6.0 && cpi >= 2.0 ? "Within 4%±2% Band ✓" : "Breaches 6% Upper Limit ⚠️";
        readout.innerHTML = `
          <div><span class="text-slate-500 block">Projected CPI</span><strong class="text-amber-400">${cpi.toFixed(2)}%</strong></div>
          <div><span class="text-slate-500 block">Real GDP Growth</span><strong class="text-emerald-400">${gdp.toFixed(2)}%</strong></div>
          <div><span class="text-slate-500 block">RBI Mandate</span><strong class="text-neoncyan">${bandStatus}</strong></div>
        `;
      }
    }

    setInterval(() => {
      if (appState.track === 'neet' && !document.getElementById('tab-simulators').classList.contains('hidden')) {
        simPhase += 4;
        renderInteractiveSimulator();
      }
    }, 60);

